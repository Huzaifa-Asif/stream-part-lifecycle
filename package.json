{
  "name": "stream-part-lifecycle",
  "version": "1.0.0",
  "description": "Audit keyed start/delta/end stream parts before they corrupt UI state.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "node scripts/verify-package.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --experimental-test-coverage",
    "example": "node examples/audit-stream.mjs",
    "check": "npm run lint && npm run build && npm test && npm run example && npm pack --dry-run --json --cache ./.npm-cache"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["ai", "stream", "lifecycle", "audit", "ui-message", "state-machine"],
  "license": "MIT",
  "author": "Huzaifa Asif",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huzaifa-Asif/stream-part-lifecycle.git"
  },
  "bugs": {
    "url": "https://github.com/Huzaifa-Asif/stream-part-lifecycle/issues"
  },
  "homepage": "https://github.com/Huzaifa-Asif/stream-part-lifecycle#readme",
  "publishConfig": {
    "access": "public"
  }
}
